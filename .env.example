# Postgres connection string (Neon: use the *pooled* connection string).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/ptm

# Encrypts session cookies and signs teacher links. At least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me-change-me

# One-time code for creating the first admin account at /admin/setup.
SETUP_TOKEN=
